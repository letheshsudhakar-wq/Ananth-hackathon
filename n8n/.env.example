# n8n Environment Configuration Template (Self-Hosted Community Edition)
# Copy to n8n/.env for local configuration

# Host & Network
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Python Backend Connection
# Prefer 127.0.0.1 on Windows: localhost can add ~2s IPv6 fallback latency.
ANANTH_BACKEND_URL=http://127.0.0.1:8000
N8N_BRIDGE_SECRET=ananth_internal_bridge_secret_demo

# Phase 3 optional integrations (backend process, never exposed to n8n)
# Leave empty to run deterministic template/recovery fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=8
GEMINI_MAX_RETRIES=2
DETECTIF_API_URL=
DETECTIF_API_KEY=
DETECTIF_TIMEOUT_SECONDS=10
ANANTH_PRODUCTION_MODE=false

# Security & Executions
N8N_ENCRYPTION_KEY=replace_with_a_secure_random_key_for_production
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_MAX_AGE=168

# Telemetry
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
